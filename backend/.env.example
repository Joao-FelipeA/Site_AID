# Servidor
PORT=3000

# PostgreSQL (ajuste usuario/senha/host/porta/nome do banco)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/projeto_aid?schema=public"

# So necessaria se DATABASE_URL apontar pra um pooler (ex: Supabase porta
# 6543/pgbouncer). O Prisma Migrate usa DIRECT_URL (conexao direta, sem
# pooler) pra rodar migrations; o app em runtime continua usando a
# DATABASE_URL pooled normalmente. Em Postgres local/direto, pode deixar
# igual a DATABASE_URL ou simplesmente nao definir.
# No Supabase: Settings > Database > Connection string > "Direct connection" (porta 5432).
DIRECT_URL="postgresql://usuario:senha@localhost:5432/projeto_aid?schema=public"

# Autenticacao
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Regras de negocio
CAPACIDADE_MAXIMA_POR_DIA=15
# Capacidade por horario de robotica (13h/14h/15h/16h, todas as sextas).
# Se nao definida, cai pra CAPACIDADE_MAXIMA_POR_DIA.
CAPACIDADE_MAXIMA_ROBOTICA=15

# URL onde o frontend estatico (pasta frontend/) e servido.
# Usada para montar o link embutido no QR code de presenca.
FRONTEND_URL="http://localhost:5500"

# Google Sheets - so usado pra EXPORTAR doacoes/frequencia (planilhas
# privadas, precisam de conta de servico com acesso de Editor).
# A IMPORTACAO de alunos nao usa isso: o admin cola o ID/link da planilha
# (publica) direto no painel a cada importacao.
GOOGLE_CLIENT_EMAIL="conta-de-servico@projeto.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUACHAVEAQUI\n-----END PRIVATE KEY-----\n"

# ID de cada planilha (a parte do link entre /d/ e /edit)
GOOGLE_SHEET_DOACOES_ID=""
GOOGLE_SHEET_FREQUENCIA_ID=""
